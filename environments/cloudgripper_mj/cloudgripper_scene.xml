<mujoco>
  <compiler meshdir="./mesh" balanceinertia="true" inertiafromgeom="true"/>
  <!-- elliptic (not the default pyramidal) friction cone: the pyramidal
       approximation underestimates available friction in oblique
       directions, especially with condim=6 (normal + sliding + torsional
       + rolling) contacts like the cube-finger grip — measured directly:
       switching to elliptic alone took small-cube (10-12mm) grasp success
       from 0/5 to 4/5 on a fixed seed set, with no other change. Grip
       force/stiffness (kp) and raw friction magnitude were ruled out
       first (scaling either up to 8x made no difference or made things
       worse) — this was a solver-accuracy issue, not a force one. -->
  <option cone="elliptic"/>
  <visual>
    <headlight active="1"/>
  </visual>
  <default>
    <joint damping="0.1" armature="0.01"/>

    <!-- STANDARD PHYSICAL GEOMS (default) -->
    <!-- <geom contype="1" conaffinity="1"type="mesh"/> -->

    <!-- VISUAL ONLY GEOMS Class -->
    <default class="visual_mesh">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
  </default>
  
  <asset>
    <material name="glass_floor" rgba="1 1 1 0.25" shininess="0.9" specular="0.8" reflectance="0.8"/>
    <material name="gray_mat" rgba="0.87294 0.95294 0.87294 1"/>
    <material name="led_light" rgba="1 1 1 1" emission="1.0" specular="0.0" reflectance="0.0"/>
    <material name="yellow_plastic" rgba="1.0 0.8 0.15 1" specular="0.4" shininess="0.4"/>
    <material name="black_plastic" rgba="0.0 0.0 0.0 1" specular="0.4" shininess="0.4"/>
    <material name="seethrough_plastic" rgba="1.0 1.0 1.0 0.3" specular="0.4" shininess="0.4"/>
    <material name="metal" rgba="0.8 0.8 0.8 1" specular="1.0" shininess="0.9" metallic="1.0" />
  </asset>

  <actuator>
    <intvelocity name="x_actuator"             joint="Rail_joint"      ctrlrange="-0.125 0.125" kp="200" forcerange="-100 100" actrange="-0.1 0.1"/>
    <intvelocity name="y_actuator"             joint="Slider_joint"    ctrlrange="-0.125 0.125" kp="200" forcerange="-100 100" actrange="-0.08 0.08"/>
    <intvelocity name="z_actuator"             joint="Linear_joint"    ctrlrange="-0.028 0.028" kp="200" forcerange="-100 100" actrange="0.0 0.043"/>
    <intvelocity name="rotate_actuator"        joint="Rotation_joint"  ctrlrange="-2.209 2.209" kp="200" forcerange="-100 100" actrange="-1.5708 1.5708"/>
    <intvelocity name="gripper_right_actuator" joint="RightSpur_joint" ctrlrange="-0.736 0.736" kp="200" forcerange="-100 100" actrange="-0.7854 0.7854"/>
  </actuator>

  <equality>
    <!-- First define parallel mechanism linkage for the right finger (which is actuated by the servo motor) -->
    <!-- 1) Let the right finger move by the opposite amount of "SpurGear1_v1" -->
    <joint name="finger_parallel_right" joint1="RightSpur_joint" joint2="RightFinger_joint" polycoef="0 -1 0 0 0" />
    
    <!-- 2) Let the front linkage rotate the same as "SpurGear1_v1" -->
    <joint name="parallel_link_right_front" joint1="RightSpur_joint" joint2="LinkFrontRight_joint" polycoef="0 -1 0 0 0" />

    <!-- 3) Let the back linkage rotate the same as "SpurGear1_v1" -->
    <joint name="parallel_link_right_back" joint1="RightSpur_joint" joint2="LinkBackRight_joint" polycoef="0 1 0 0 0" />
    
    <!-- 4) Let the left finger move by the opposite amount of "SpurGear2_v1" -->
    <joint name="finger_parallel_left" joint1="LeftSpur_joint" joint2="LeftFinger_joint" polycoef="0 -1 0 0 0" />
    
    <!-- 5) Let the front linkage rotate the same as "SpurGear2_v1" -->
    <joint name="parallel_link_left_front" joint1="LeftSpur_joint" joint2="LinkFrontLeft_joint" polycoef="0 -1 0 0 0" />

    <!-- 6) Let the back linkage rotate the same as "SpurGear2_v1" -->
    <joint name="parallel_link_left_back" joint1="LeftSpur_joint" joint2="LinkBackLeft_joint" polycoef="0 1 0 0 0" />

    <!-- 7) Let "SpurGear2_v1" rotate opposite to "SpurGear1_v1" (Gear connection)-->
    <joint name="spur_gear_mechanism" joint1="RightSpur_joint" joint2="LeftSpur_joint" polycoef="0 -1 0 0 0" />
</equality>


